# Path to the file holding the SimpleFIN access URL (local runs).
SIMPLEFIN_ACCESS_URL_PATH=~/.simplefin-access
# In GitHub Actions the URL is injected directly as a secret instead:
# SIMPLEFIN_ACCESS_URL=

DRIVE_FOLDER_NAME=Finances

# Categorization
USE_JEV=false
JEV_CONFIDENCE_THRESHOLD=0.8
TYPESAFE_API_KEY=

# Google OAuth (desktop app flow); refresh token minted once via scripts/auth.py
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
